<?xml version="1.0" encoding="UTF-8"?>
<!--
    WPML configuration for pi-blocks plugin.

    field_type values:
      line  = single-line text (titles, labels, short strings)
      area  = multi-line / HTML text (descriptions, paragraphs, RichText)
      image = image URL (not translated, used only for media duplication)

    Array attributes (items, testimonials, counters, hoursItems…) are handled
    automatically by WPML's Advanced Translation Editor (ATE): it reads the
    block's serialised JSON comment and presents every string value as a
    translatable field. They do NOT need individual <field> entries here.

    Query-based blocks (sectors-list, teams-list, insights, service-list,
    post-carousel, related-list) pull text from post content — translated via
    WPML's normal post-translation workflow, not block attributes.

    Layout/structural blocks (pi-columns, pi-column, pi-container,
    pi-separator-block, client-block) contain no translatable text attributes.
-->
<wpml-config>
    <gutenberg-blocks>

        <!-- ═══════════════════════════════════════════════════════════════
             HERO BLOCK  —  pi-blocks/hero
             Flat string attrs only; image handled by Media Translation.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/hero">
            <fields>
                <field name="scrollLabel" field_type="line" label="Nút cuộn trang" />
                <field name="imgAlt"      field_type="line" label="Alt text ảnh nền" />
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             CONTENT MEDIA  —  pi-blocks/content-media
             items[] has only imgUrl (not translatable).
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/content-media">
            <fields>
                <field name="contentTitle" field_type="line" label="Tiêu đề" />
                <field name="contentText"  field_type="area" label="Nội dung mô tả" />
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             TEXT WITH COUNTER  —  pi-blocks/block-text-w-counter
             counters[] items: { heading (line), number (line) }
             → translated automatically by WPML ATE (JSON scanning).
             InnerBlocks text content translated via standard post workflow.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/block-text-w-counter">
            <fields>
                <!-- counters array { heading, number } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             TESTIMONIALS CAROUSEL  —  pi-blocks/block-testimonials-carousel
             testimonials[] items: { quote (area), name (line), position (line) }
             → array translated automatically by WPML ATE.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/block-testimonials-carousel">
            <fields>
                <field name="heading" field_type="line" label="Tiêu đề section" />
                <!-- testimonials array { quote, name, position } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             PROCESS STEPS  —  pi-blocks/process-steps
             items[] items: { title (line), description (area), imgAlt (line) }
             → array translated automatically by WPML ATE.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/process-steps">
            <fields>
                <!-- items array { title, description, imgAlt } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             FAQ ACCORDION  —  pi-blocks/block-faq
             items[] items: { question (line), answer (area) }
             Both fields are also rendered via RichText → found in saved HTML.
             Array also handled by WPML ATE for attribute-level translation.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/block-faq">
            <fields>
                <!-- items array { question, answer } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             INFO BOX  —  pi-blocks/info-box  (SSR, dynamic block)
             rows[] không cần đăng ký — WPML ATE quét JSON tự động.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/info-box">
            <fields>
                <field name="phone"      field_type="line" label="Hotline" />
                <field name="phoneHours" field_type="line" label="Phụ đề hotline" />
                <field name="email"      field_type="line" label="Email" />
                <field name="zaloName"   field_type="line" label="Tên Zalo Page" />
                <field name="zaloSub"    field_type="line" label="Phụ đề Zalo" />
                <field name="zaloUrl"    field_type="line" label="Link Zalo" />
                <field name="address"    field_type="area" label="Địa chỉ văn phòng" />
                <field name="phoneIcon"   field_type="image" label="Icon hotline" />
                <field name="emailIcon"   field_type="image" label="Icon email" />
                <field name="zaloIcon"    field_type="image" label="Icon Zalo" />
                <field name="addressIcon" field_type="image" label="Icon địa chỉ" />
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             BUSINESS HOURS  —  pi-blocks/business-hours  (SSR, dynamic block)
             rows[] items: { days (line), time (line) }
             → array translated automatically by WPML ATE.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/business-hours">
            <fields>
                <field name="title"      field_type="line" label="Tiêu đề giờ làm việc" />
                <field name="footerNote" field_type="area" label="Ghi chú cuối" />
                <!-- rows array { days, time } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             CONTACT INFO  —  pi-blocks/contact-info
             hoursItems[] items: { days (line), time (line) }
             → array translated automatically by WPML ATE.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/contact-info">
            <fields>
                <field name="address" field_type="area" label="Địa chỉ" />
                <field name="phone"   field_type="line" label="Điện thoại" />
                <field name="email"   field_type="line" label="Email" />
                <!-- hoursItems array { days, time } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             GALLERY CAROUSEL  —  pi-blocks/gallery-carousel
             items[] items: { url (image), alt (line) }
             alt text registered here; WPML ATE picks up remaining strings.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/gallery-carousel">
            <fields>
                <!-- items array { url, alt } — alt handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             LOGO CAROUSEL  —  pi-blocks/logo-carousel
             items[] items: { url (image), alt (line) }
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/logo-carousel">
            <fields>
                <!-- items array { url, alt } — alt handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             TECHNOLOGY CAROUSEL  —  pi-blocks/block-technology
             items[] items: { image: {id,url,alt}, title (line), description (area) }
             → title & description translated automatically by WPML ATE (JSON scan).
             image.url / image.id are NOT translated (media handled by Media Translation).
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/block-technology">
            <fields>
                <!-- items array { image, title, description } — handled by WPML ATE -->
            </fields>
        </block>

        <!-- ═══════════════════════════════════════════════════════════════
             TEAM GRID  —  pi-blocks/block-team-grid  (SSR / PHP render)
             Post content ("teams" CPT) translated via post-translation workflow.
             link_label is a plain-text attribute shown in Inspector → must be
             registered here so WPML Translation Editor can translate it.
        ═══════════════════════════════════════════════════════════════ -->
        <block type="pi-blocks/block-team-grid">
            <fields>
                <field name="link_label" field_type="line" label="Nhãn nút xem hồ sơ" />
            </fields>
        </block>

        <!--
            ─── Blocks with NO translatable text attributes ──────────────

            pi-blocks/pi-separator-block  — visual only (colors, sizes)
            pi-blocks/pi-columns          — layout InnerBlocks wrapper
            pi-blocks/pi-column           — layout InnerBlocks item
            pi-blocks/pi-container        — layout InnerBlocks wrapper
            pi-blocks/client-block        — dynamic render, no text attrs

            ─── Query-based / SSR blocks (text from post content) ────────

            pi-blocks/block-sectors-list      — renders CPT "sectors"
            pi-blocks/block-teams-list        — renders CPT "teams"
            pi-blocks/block-service-list      — renders CPT "service"
            pi-blocks/block-service-carousel  — renders service_group + service_category;
                                                CTA string registered via wpml_register_single_string in PHP
            pi-blocks/block-insights          — renders blog posts
            pi-blocks/block-post-carousel     — renders blog posts
            pi-blocks/block-related-list      — renders case studies by taxonomy

            These blocks display text that comes from translated posts/CPTs,
            so WPML handles translation via the standard post-translation
            workflow — no block attribute registration needed here.
        -->

    </gutenberg-blocks>
</wpml-config>
